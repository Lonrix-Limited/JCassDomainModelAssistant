<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- The verb the docs and the skills call. Note this is NOT the situation the
         reference model's README warns about: <AssemblyName> is dangerous in a
         DOMAIN MODEL because the debug run derives the class name from the .csproj
         filename while a normal run reads it from the bundle, so the two disagree
         silently. Nothing resolves this assembly by reflection - here the setting
         just names the executable. -->
    <AssemblyName>jcass-dm</AssemblyName>
    <RootNamespace>JcassDm</RootNamespace>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Title>jcass-dm</Title>
    <Description>Reads and writes the Juno Cassandra domain model bundle (domain_model_setup.xlsx).</Description>
    <Copyright>Lonrix Ltd 2026</Copyright>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scaffolder's skeleton, embedded rather than shipped as loose files beside the exe.

         The alternative was a tools/templates/ folder the exe reads at run time, which would be
         nicer to browse and diff. It loses on the one property that matters: jcass-dm has to work
         when it is the only thing somebody copied. A template folder that goes missing turns a
         generator into a confusing partial failure, and "clone and go" is a hard property of this
         project. They are still readable and diffable here, as .template source files - and they
         are excluded from compilation by the extension, so the placeholders inside them cannot
         break the build. -->
    <!-- WithCulture="false" is load-bearing and its absence is silent. MSBuild's AssignCulture
         task reads the second-to-last extension of a resource file name as a culture, and "cs"
         in Constants.cs.template is Czech - so without this every C# template is routed into a
         cs\ satellite assembly and GetManifestResourceStream finds nothing. The scaffolder then
         fails at run time on a build that was perfectly green. -->
    <EmbeddedResource Include="Templates\**\*.template" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- ClosedXML directly, NOT JCass_Excel.

         JCass_Excel reaches this repository only as a REFERENCE assembly
         (refs/JCass_Excel.dll): it compiles and gives IntelliSense, and the runtime
         refuses to load it, so a tool built against it would fail on its first call.
         ClosedXML is the same engine JCass_Excel wraps, and this tool deliberately
         mirrors ExcelHelperOXML's read semantics (see SheetTable), so the framework
         reads exactly what is written here. tools/README.md records the decision. -->
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JcassDm.Tests" />
  </ItemGroup>

</Project>
