<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      DELIBERATELY NOT SET: <AssemblyName>.
      Leaving it unset makes the assembly name default to the .csproj file stem, which is what
      keeps the four names aligned. See "The four-name rule" in README.md before you rename
      anything in this project.
    -->
  </PropertyGroup>

  <!--
    Framework references come from the sibling refs\ folder, NOT from <ProjectReference>.

    Two reasons this is a wildcard over a folder rather than a list of named assemblies:

      1. You do not have the framework source, so a <ProjectReference> is not an option.
      2. The web Debug Model workspace stages framework DLLs into refs\ for you (it drops in
         roughly ten times as many files as the local copy command in README.md does, because
         it also stages NuGet transitives). A wildcard picks up whatever is actually there,
         so this exact csproj builds unchanged both on your machine and in the debug sidecar.

    Private=false means "do not copy these into bin\". That is correct and load-bearing: at run
    time the framework host has already loaded its own copy of every one of these assemblies,
    and a duplicate next to your DLL only invites version confusion. Your bin\ folder should
    contain DomainModelSample.dll and DomainModelSample.pdb, nothing else.
  -->
  <ItemGroup>
    <Reference Include="refs\*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
