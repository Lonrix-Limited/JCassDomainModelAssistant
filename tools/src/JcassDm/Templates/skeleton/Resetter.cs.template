using System;
using JCass_ModelCore.Models;
using JCass_ModelCore.Treatments;

namespace {{NAMESPACE}};

/// <summary>
/// Stage 4b of 6: how an element changes when a treatment is applied to it.
///
/// <para>Called instead of <see cref="Incrementer"/>, for the elements the optimiser chose to
/// fund. Everything the forecast says about the benefit of spending money comes from this file,
/// which makes it the other half of the pair that decides whether a business case stacks
/// up.</para>
///
/// <para><b>The <c>switch</c> below is deliberately exhaustive with a throwing <c>default</c>.</b>
/// A treatment declared in the bundle, triggered by <see cref="TreatmentsTrigger"/>, and then not
/// handled here would be funded, charged to a budget, reported as delivered - and change nothing
/// about the element's condition. The forecast would show money being spent for no benefit and
/// nothing would say why. Throwing turns that into a message on the first period it happens.
/// <c>jcass-dm check</c> looks for the same thing before you run.</para>
///
/// <para><b>Resets are tunable numbers too.</b> "A repair takes condition back to 20" is exactly
/// the kind of assumption a modeller wants to test against observed post-treatment surveys. It
/// belongs in <c>lookups.xlsx</c>, read through <see cref="Constants"/>.</para>
/// </summary>
public class Resetter
{
    private readonly ModelBase _frameworkModel;
    private readonly {{MODEL}} _domainModel;

    /// <summary>
    /// Creates the resetter. Built once in <see cref="{{MODEL}}.SetupInstance"/>.
    /// </summary>
    /// <param name="frameworkModel">The framework model, for lookups and treatment types.</param>
    /// <param name="domainModel">This domain model, for its <see cref="Constants"/>.</param>
    public Resetter(ModelBase frameworkModel, {{MODEL}} domainModel)
    {
        _frameworkModel = frameworkModel ?? throw new ArgumentNullException(nameof(frameworkModel));
        _domainModel = domainModel ?? throw new ArgumentNullException(nameof(domainModel));
    }

    /// <summary>
    /// Applies the effect of a treatment to one element. Returns the same instance, mutated -
    /// the caller writes it straight back through the parameter sinks.
    /// </summary>
    /// <param name="element">The element that was treated.</param>
    /// <param name="period">Modelling period (1-based) the treatment was applied in.</param>
    /// <param name="treatment">The treatment the optimiser selected.</param>
    public {{ELEMENT}} Reset({{ELEMENT}} element, int period, TreatmentInstance treatment)
    {
        switch (treatment.TreatmentName)
        {
            // One case per constant on TreatmentNames, e.g.
            //
            //   case TreatmentNames.Repair:
            //       element.ConditionRating = _domainModel.Constants.ConditionAfterRepair;
            //       element.Age = 0;
            //       break;
            //
            // Routine maintenance usually holds condition where it is and does NOT reset age -
            // it is a holding action, not a renewal. Give it an explicit empty case rather than
            // letting it fall to the default, so the intent is written down.

            default:
                throw new Exception(
                    $"Treatment '{treatment.TreatmentName}' is not handled by Resetter.Reset(). " +
                    "Add a case for it here, or remove it from the treatments sheet of the bundle.");
        }
    }
}
